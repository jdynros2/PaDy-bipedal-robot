      </link>
    </model> -->

     <!-- Sunlight -->
    <light type="directional" name="sun">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.5 0.5 0.5 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
      <cast_shadows>true</cast_shadows>
    </light>

    <!-- 3.5-degree slope (10m long x 2m wide) -->
    <model name="slope">
      <static>true</static>
      <!-- Rotate -3.5 degrees about Y axis = downward slope in X direction -->
      <pose>5 0 0 0 0.0611 0</pose>
      <link name="slope_link">
        <collision name="collision">
          <geometry>
            <box>
              <size>10 2 0.05</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <!-- High friction for passive walking (must match or exceed foot mu) -->
                <mu>70.0</mu>
                <mu2>70.0</mu2>
              </ode>
            </friction>
            <contact>
              <ode>
                <!-- Hard contact - stiff floor -->
                <kp>1000000.0</kp>
                <kd>100.0</kd>
                <max_vel>0.1</max_vel>
                <min_depth>0.001</min_depth>
              </ode>
            </contact>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>10 2 0.05</size>
            </box>
          </geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Ground plane – flat safety surface below the slope.
         The slope surface descends from z=+0.287 m (x=0) to z=-0.325 m (x=10 m).
         This plane at z=-0.4 sits just below the slope's lowest edge so the robot
         cannot fall into the abyss when it reaches the bottom of the ramp. -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.5 0.6 0.5 1</ambient>
            <diffuse>0.6 0.7 0.6 1</diffuse>
          </material>
        </visual>
      </link>
      <pose>0 0 -0.4 0 0 0</pose>
    </model>

  </world>
</sdf>
