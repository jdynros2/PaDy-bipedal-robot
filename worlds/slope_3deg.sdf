<?xml version="1.0"?>

<sdf version="1.9">
  <world name="slope_world">
  
    <physics name="1ms" type="dart">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- World gravity (SDF 1.9: gravity is a world-level element, not inside physics) -->
    <gravity>0 0 -9.81</gravity>

    <!-- Required Gazebo plugins -->
    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system"
            name="gz::sim::systems::Contact"/>
    <!-- Required for ros_gz_sim create to spawn models into this world -->
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <!-- Wrench system: allows yaw_corrector node to apply torques via
         /world/slope_world/wrench topic (gz.msgs.EntityWrench) -->
    <plugin filename="gz-sim-apply-link-wrench-system"
            name="gz::sim::systems::ApplyLinkWrench"/>

  
    <!-- Guiderails: two cylinders parallel to slope, Z=1.0m, Y=±0.15m, radius=0.005m, length=10m -->
    <!-- <model name="guiderail_left">
      <static>true</static>
      <pose>5 0.6 0.7 0 1.63188 0</pose>
      <link name="rail">
        <collision name="rail_collision">
          <geometry>
            <cylinder>
              <radius>0.005</radius>
              <length>10.0</length>
            </cylinder>
          </geometry>
          <surface>
            <friction>
