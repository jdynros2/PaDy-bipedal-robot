<?xml version="1.0"?>
<!-- PaDy Bipedal Walker URDF
     ===================================================================
     MESH COORDINATE SYSTEM NOTE
     ===================================================================
     All STL files were exported from Fusion 360 as a single assembly in
     absolute CAD world coordinates (Y-up convention).  In the CAD frame:
       CAD X → URDF Y  (lateral, +left)
       CAD Y → URDF Z  (vertical, +up)
       CAD Z → URDF X  (sagittal, +forward)

     Every visual/collision <origin> therefore carries:
       rpy="1.5708 0 1.5708"   (Rx=90°, Rz=90° — maps CAD axes to URDF)
       xyz = −R · P_joint_cad  (cancels each joint's absolute CAD position)

     Joint positions read from STL bounding boxes (mm, CAD frame):
       base_link origin : (0,    1018, 0)
       hip joints       : (±107.86, 1001, 0)   [+x = left, −x = right]
       knee joints      : (±107.86,  501, 0)
       foot joints      : (±107.86,    1, 20)  [20 mm forward in CAD Z]

     Hip / knee joint origins and limits define the kinematics and are
     correct — only the visual/collision origins needed fixing.

    Practical tuning map (edit in this file)
    ========================================
    - Foot cant: <joint name="foot_joint_*"> origin rpy roll values.
    - Contact grip/compliance: <gazebo reference="foot_*"> mu1/mu2/kp/kd.
    - Joint passivity/damping: <joint ...><dynamics damping="..."/>.
    - Mass/inertia distribution: each link <inertial> block.

    Runtime force/timing parameters are tuned in launch files, not here.
-->

<robot name="pady">

  <!-- ═══════════════════════════════════════════════════════════════
       YAW ANCHOR — inertial reference for yaw correction
       ═══════════════════════════════════════════════════════════════
       Invisible link with high Izz (0.1 kg·m²) that resists yaw rotation.
       Connected to base_link via a revolute Z-joint with passive damping.
       The yaw_corrector node applies active correction through ApplyJointForce.
       The anchor becomes the model root (free body), base_link hangs below it.
       Mass is negligible (0.01 kg) so it doesn't affect translational dynamics.
       ═══════════════════════════════════════════════════════════════ -->
  <link name="yaw_anchor">
    <inertial>
      <mass value="0.0001"/>
      <!-- Near-zero inertia: anchor spins freely under reaction torque
           but base_link still receives full corrective torque from the joint.
           Triangle inequality: 0.0005+0.0005≥0.001 ✓
           Adds <8% to Ixx and <3% to Iyy of base_link. -->
      <inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.0005" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <joint name="yaw_joint" type="revolute">
    <parent link="yaw_anchor"/>
    <child link="base_link"/>
    <axis xyz="0 0 1"/>
    <limit effort="100" lower="-3.14159" upper="3.14159" velocity="10.0"/>
    <dynamics damping="2.0" friction="0.0"/>
  </joint>

  <!-- ═══════════════════════════════════════════════════════════════
       BASE LINK  (hip / pelvis)
       ═══════════════════════════════════════════════════════════════ -->
  <link name="base_link">
    <visual>
      <!-- CAD origin (0,1018,0) mm → offset (0, 0, -1.018) m -->
      <origin xyz="1.042 0.037 -0.005" rpy="0 0 1.5708"/>
      <geometry>
        <mesh filename="package://pady_robot/meshes/visual/base_link.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="blue"><color rgba="0.2 0.4 0.8 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="1.042 0.037 -0.005" rpy="0 0 1.5708"/>
      <geometry>
        <mesh filename="package://pady_robot/meshes/visual/base_link.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="1.600"/>
      <origin xyz="0 0 -0.015" rpy="0 0 0"/>
      <inertia ixx="0.00637" ixy="0.0" ixz="0.0" iyy="0.01990" iyz="0.0" izz="0.025"/>
    </inertial>
  </link>

  <!-- ═══════════════════════════════════════════════════════════════
       RIGHT LEG
       ═══════════════════════════════════════════════════════════════ -->

  <!-- Hip Joint Right – revolute, sagittal plane (Y-axis) -->
  <joint name="hip_joint_right" type="revolute">
    <parent link="base_link"/>
    <child link="thigh_right"/>
    <origin xyz="0 -0.10786 -0.017" rpy="0 0.28 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="400" lower="-0.5418" upper="0.0418" velocity="10.0"/>
    <dynamics damping="0.001" friction="0.001"/>
  </joint>

  <link name="thigh_right">
    <visual>
      <!-- CAD joint (−107.86, 1001, 0) → offset (0, +0.10786, −1.001) -->
      <origin xyz="0 0.10786 -1.001" rpy="1.5708 0 1.5708"/>
      <geometry>
        <mesh filename="package://pady_robot/meshes/visual/thigh_right.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="grey"><color rgba="0.7 0.7 0.7 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0.10786 -1.001" rpy="1.5708 0 1.5708"/>
      <geometry>
        <mesh filename="package://pady_robot/meshes/visual/thigh_right.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.437"/>
      <origin xyz="0 0 -0.25" rpy="0 0 0"/>
      <inertia ixx="0.009162" ixy="0.0" ixz="0.0" iyy="0.009162" iyz="0.0" izz="0.000058"/>
    </inertial>
  </link>

  <!-- Knee Joint Right
       lower=0.0  → fully extended = LOCKED against hyperextension (stance phase)
       upper=1.1345 (~65°) → backward flexion via positive Y rotation (swing phase)
       axis "0 1 0": Rx(+) swings shin tip in −X (backward) = correct knee flexion -->
  <!-- Knee Joint Right:
       lower=0.0 → hyperextension blocked (acts as stance latch — no damping needed)
       Damping MUST be near-zero so the shin freely swings backward during swing
       phase (centripetal inertia lifts the foot). The constraint at lower=0 holds
       the leg straight during stance without needing high damping. -->

  <joint name="knee_joint_right" type="revolute">
    <parent link="thigh_right"/>
    <child link="shin_right"/>
    <origin xyz="0 0 -0.500" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="100" lower="0.0" upper="1.1345" velocity="10.0"/>
    <!-- damping near-zero: knee swings freely; locking is done by knee_lock node -->
    <dynamics damping="0.0" friction="0.0001"/>
  </joint>

  <link name="shin_right">
    <visual>
      <!-- CAD joint (−107.86, 501, 0) → offset (0, +0.10786, −0.501) -->
      <origin xyz="0 0.10786 -0.501" rpy="1.5708 0 1.5708"/>
      <geometry>
        <mesh filename="package://pady_robot/meshes/visual/shin_right.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin xyz="0 0.10786 -0.501" rpy="1.5708 0 1.5708"/>
      <geometry>
        <mesh filename="package://pady_robot/meshes/visual/shin_right.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.350"/>
      <origin xyz="0 0 -0.25" rpy="0 0 0"/>
      <inertia ixx="0.007338" ixy="0.0" ixz="0.0" iyy="0.007338" iyz="0.0" izz="0.000047"/>
    </inertial>
  </link>

  <!-- Foot Joint Right – fixed, canted outward 0.20 rad (≈11.5°).
       Negative roll tilts the sole toward −Y (outer side). When standing on
       the right foot, contact is on the outer edge; the CoM is to the left
       of that edge, so the robot rocks rightward, lifting the left swing foot.
       This is the Collins 2001 lateral-clearance mechanism. -->
  <joint name="foot_joint_right" type="fixed">
    <parent link="shin_right"/>
    <child link="foot_right"/>
    <!-- Cant outward + foot centred under shin (0mm offset) to avoid toe drag -->
    <origin xyz="0.0 0 -0.500" rpy="-0.08 0.0 0.0"/>
  </joint>

  <link name="foot_right">
    <visual>
      <!-- rpy="0 0 4.71239" = Rz(-90°): CAD-X→-URDF-Y, CAD-Y→URDF-X, CAD-Z→URDF-Z
           xyz = -Rz(-90°) · P_joint/1000, P_joint=(-107.86, 1, 20)mm → (-0.001, -0.10786, -0.020) -->
      <origin xyz="0.1175 -0.1091 -0.020" rpy="0 0 4.71239"/>
      <geometry>
        <mesh filename="package://pady_robot/meshes/visual/right_foot.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="dark_grey"><color rgba="0.3 0.3 0.3 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0.1175 -0.1091 -0.020" rpy="0 0 4.71239"/>
      <geometry>
        <mesh filename="package://pady_robot/meshes/visual/right_foot.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.175"/>
      <origin xyz="0.040 0 -0.015" rpy="0 0 0"/>
      <inertia ixx="0.000118" ixy="0.0" ixz="0.0" iyy="0.000299" iyz="0.0" izz="0.000391"/>
    </inertial>
  </link>

  <!-- ═══════════════════════════════════════════════════════════════
       LEFT LEG
       ═══════════════════════════════════════════════════════════════ -->

  <!-- Hip Joint Left – revolute, sagittal plane (Y-axis) -->
  <joint name="hip_joint_left" type="revolute">
    <parent link="base_link"/>
    <child link="thigh_left"/>
    <origin xyz="0 0.10786 -0.017" rpy="0 -0.28 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="400" lower="-0.0418" upper="0.5418" velocity="10.0"/>
    <dynamics damping="0.001" friction="0.001"/>
  </joint>

  <link name="thigh_left">
    <visual>
      <!-- CAD joint (+107.86, 1001, 0) → offset (0, −0.10786, −1.001) -->
      <origin xyz="0 -0.10786 -1.001" rpy="1.5708 0 1.5708"/>
      <geometry>
        <mesh filename="package://pady_robot/meshes/visual/thigh_left.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin xyz="0 -0.10786 -1.001" rpy="1.5708 0 1.5708"/>
      <geometry>
        <mesh filename="package://pady_robot/meshes/visual/thigh_left.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.437"/>
      <origin xyz="0 0 -0.25" rpy="0 0 0"/>
      <inertia ixx="0.009162" ixy="0.0" ixz="0.0" iyy="0.009162" iyz="0.0" izz="0.000058"/>
    </inertial>
  </link>

  <!-- Knee Joint Left — no damping so the knee is fully passive during
       swing and stance (dynamics rely solely on mass distribution and contact) -->
  <joint name="knee_joint_left" type="revolute">
    <parent link="thigh_left"/>
    <child link="shin_left"/>
    <origin xyz="0 0 -0.500" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="100" lower="0.0" upper="1.1345" velocity="10.0"/>
    <!-- damping near-zero: knee swings freely; locking is done by knee_lock node -->
    <dynamics damping="0.0" friction="0.0001"/>
  </joint>

  <link name="shin_left">
    <visual>
      <!-- CAD joint (+107.86, 501, 0) → offset (0, −0.10786, −0.501) -->
      <origin xyz="0 -0.10786 -0.501" rpy="1.5708 0 1.5708"/>
      <geometry>
        <mesh filename="package://pady_robot/meshes/visual/shin_left.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin xyz="0 -0.10786 -0.501" rpy="1.5708 0 1.5708"/>
      <geometry>
        <mesh filename="package://pady_robot/meshes/visual/shin_left.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.350"/>
      <origin xyz="0 0 -0.25" rpy="0 0 0"/>
      <inertia ixx="0.007338" ixy="0.0" ixz="0.0" iyy="0.007338" iyz="0.0" izz="0.000047"/>
    </inertial>
  </link>

  <!-- Foot Joint Left – mirror cant of right: +0.13 rad toward +Y (outer side) -->
  <joint name="foot_joint_left" type="fixed">
    <parent link="shin_left"/>
    <child link="foot_left"/>
    <!-- Cant outward + foot centred under shin (0mm offset) to avoid toe drag -->
    <origin xyz="0.0 0 -0.500" rpy="0.08 0.0 0.0"/>
  </joint>

  <link name="foot_left">
    <visual>
      <!-- rpy="0 0 4.71239" = Rz(-90°): xyz = -Rz(-90°) · P_joint/1000
           P_joint=(+107.86, 1, 20)mm → (-0.001, +0.10786, -0.020) -->
      <origin xyz="0.1175 0.1091 -0.020" rpy="0 0 4.71239"/>
      <geometry>
        <mesh filename="package://pady_robot/meshes/visual/left_foot.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <origin xyz="0.1175 0.1091 -0.020" rpy="0 0 4.71239"/>
      <geometry>
        <mesh filename="package://pady_robot/meshes/visual/left_foot.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.175"/>
      <origin xyz="0.040 0 -0.015" rpy="0 0 0"/>
      <inertia ixx="0.000118" ixy="0.0" ixz="0.0" iyy="0.000299" iyz="0.0" izz="0.000391"/>
    </inertial>
  </link>
  
 <!-- ═══════════════════════════════════════════════════════════════════════
       ARM SYSTEM — passive counterswing arms
       ═══════════════════════════════════════════════════════════════════════
       Using CAD coordinate conversion:
       - CAD Y (vertical) → URDF z = -Py/1000
       - CAD X (lateral) → URDF y = -Px/1000  
       - CAD Z (sagittal) → URDF x = -Pz/1000
       
       Arm mesh centers (CAD): Right X≈-344mm, Left X≈+264mm, Y≈1035mm
       Hip joint position in URDF: y=±0.108m, z≈-1.0m (relative to base_link)
       ═══════════════════════════════════════════════════════════════════════ -->

  <!-- arm_joint_right: right hip position
       Joint RPY is pure Ry rotation to keep axis Y (lateral) → sagittal swing.
       Contralateral asymmetry: right arm pitched -140° (forward-down),
       left arm pitched -40° (backward-up) for counter-swing launch posture. -->
  <joint name="arm_joint_right" type="revolute">
    <parent link="base_link"/>
    <child link="arm_right"/>  
    <origin xyz="0.015 -0.2585 0.0065" rpy="0 -2.4508 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="0" lower="-0.97" upper="1.53" velocity="8.0"/>
    <!-- Underdamped (ζ≈0.44): arms oscillate freely for counter-yaw swing.
         Critical damping ≈ 0.34 Nm·s/rad; 0.15 gives good oscillation. -->
    <dynamics damping="0.15" friction="0.0001"/>
  </joint>

  <link name="arm_right">
    <visual>
      <!-- New STL in local coords: axle hole at ~(0,3,280) mm.
           Standard CAD map rpy="1.5708 0 1.5708": STL(x,y,z)→joint(z,x,y)
           xyz = -R·P_axle = -(0.280, 0, 0.003) -->
      <origin xyz="-0.280 0 -0.003" rpy="1.5708 0 1.5708"/>
      <geometry>
        <mesh filename="package://pady_robot/meshes/visual/arm_right.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="grey"/>
    </visual>
    <!-- No collision: new local-coord STLs extend from joint and
         would interpenetrate base_link, jamming the joint. -->
    <inertial>
      <mass value="0.300"/>
      <origin xyz="-0.140 0 0" rpy="0 0 0"/>
      <!-- Inertia scaled ×0.75 from previous (was 0.400 kg) for 0.300 kg arms. -->
      <inertia ixx="4.4e-5" ixy="0.0" ixz="0.0"
               iyy="1.97e-3" iyz="0.0"
               izz="2.00e-3"/>
    </inertial>
  </link>

  <!-- arm_joint_left: left hip position -->
  <joint name="arm_joint_left" type="revolute">
    <parent link="base_link"/>
    <child link="arm_left"/>
    <origin xyz="0.015 0.2585 0.0065" rpy="0 -0.6908 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="0" lower="-1.53" upper="0.97" velocity="8.0"/>
    <!-- Underdamped (ζ≈0.44): arms oscillate freely for counter-yaw swing -->
    <dynamics damping="0.15" friction="0.0001"/>
  </joint>

  <link name="arm_left">
    <visual>
      <!-- Left STL body extends z=-280→+70 (opposite of right).
           Flip Rz: rpy="1.5708 0 -1.5708" so STL -z→+URDF x, making
           the body extend in -x (same as right arm child frame).
           Axle at STL(0,3,-280)→URDF(280,0,3)→offset (-0.280,0,-0.003) -->
      <origin xyz="-0.280 0 -0.003" rpy="1.5708 0 -1.5708"/>
      <geometry>
        <mesh filename="package://pady_robot/meshes/visual/arm_left.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="grey"/>
    </visual>
    <!-- No collision: same as right arm -->
    <inertial>
      <mass value="0.300"/>
      <origin xyz="-0.140 0 0" rpy="0 0 0"/>
      <!-- Inertia scaled ×0.75 from previous (was 0.400 kg) for 0.300 kg arms. -->
      <inertia ixx="4.4e-5" ixy="0.0" ixz="0.0"
               iyy="1.97e-3" iyz="0.0"
               izz="2.00e-3"/>
    </inertial>
  </link>
  <!-- ═══════════════════════════════════════════════════════════════
       GAZEBO PROPERTIES
       ═══════════════════════════════════════════════════════════════ -->

  <!-- ApplyJointForce for gait kick — one <gazebo> element per plugin so both
       survive URDF→SDF conversion (parsers may drop duplicates in one block).
       Topics: /model/pady/joint/hip_joint_right/0/cmd_force  (gz.msgs.Double, Nm)
               /model/pady/joint/hip_joint_left/0/cmd_force
       Maintains last commanded force each step; send 0.0 to go passive. -->
  <!-- ApplyJointForce: topic must include the /0/ index used by the launch-file kick.
       Default topic omits it; explicitly setting it here ensures the two match. -->
  <gazebo>
    <plugin filename="gz-sim-apply-joint-force-system"
            name="gz::sim::systems::ApplyJointForce">
      <joint_name>yaw_joint</joint_name>
      <topic>/model/pady/joint/yaw_joint/0/cmd_force</topic>
    </plugin>
  </gazebo>
  <gazebo>
    <plugin filename="gz-sim-apply-joint-force-system"
            name="gz::sim::systems::ApplyJointForce">
      <joint_name>hip_joint_right</joint_name>
      <topic>/model/pady/joint/hip_joint_right/0/cmd_force</topic>
    </plugin>
  </gazebo>
  <gazebo>
    <plugin filename="gz-sim-apply-joint-force-system"
            name="gz::sim::systems::ApplyJointForce">
      <joint_name>hip_joint_left</joint_name>
      <topic>/model/pady/joint/hip_joint_left/0/cmd_force</topic>
    </plugin>
  </gazebo>
  <gazebo>
    <plugin filename="gz-sim-apply-joint-force-system"
            name="gz::sim::systems::ApplyJointForce">
      <joint_name>knee_joint_right</joint_name>
      <topic>/model/pady/joint/knee_joint_right/0/cmd_force</topic>
    </plugin>
  </gazebo>
  <gazebo>
    <plugin filename="gz-sim-apply-joint-force-system"
            name="gz::sim::systems::ApplyJointForce">
      <joint_name>knee_joint_left</joint_name>
      <topic>/model/pady/joint/knee_joint_left/0/cmd_force</topic>
    </plugin>
  </gazebo>

  <!-- optional body force plugin: world-level attachment so the system
       has access to the world context.  We attempt both ApplyLinkForce and
       ApplyLinkWrench; the one that exists in the current gz-sim build will
       consume the topic. -->
  <gazebo reference="world">
    <plugin filename="gz-sim-apply-link-force-system"
            name="gz::sim::systems::ApplyLinkForce">
      <link_name>base_link</link_name>
      <topic>/model/pady/link/base_link/0/cmd_force</topic>
    </plugin>
  </gazebo>
  <gazebo reference="world">
    <plugin filename="gz-sim-apply-link-wrench-system"
            name="gz::sim::systems::ApplyLinkWrench">
      <link_name>base_link</link_name>
      <topic>/model/pady/link/base_link/0/cmd_force</topic>
    </plugin>
  </gazebo>

  <!-- Foot contact model.
       Tune these values here when addressing slip/yaw/contact bounce. -->
  <gazebo reference="foot_right">
    <!-- Friction coefficients: higher values reduce lateral slip/yaw drift. -->
    <mu1>70.0</mu1>
    <mu2>70.0</mu2>
    <!-- Rubber-like contact: softer spring with higher damping to absorb impact. -->
    <kp>2500000.0</kp>
    <kd>18000.0</kd>
    <max_vel>0.05</max_vel>
    <min_depth>0.002</min_depth>
  </gazebo>

  <gazebo reference="foot_left">
    <mu1>70.0</mu1>
    <mu2>70.0</mu2>
    <kp>2500000.0</kp>
    <kd>18000.0</kd>
    <max_vel>0.05</max_vel>
    <min_depth>0.002</min_depth>
  </gazebo>

  <!-- Joint state publisher so Gazebo publishes joint angles to ROS -->
  <gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher"/>
  </gazebo>

  <!-- Publish model world-pose so gait_analyser can read hip position + RPY -->
  <gazebo>
    <plugin filename="gz-sim-pose-publisher-system"
            name="gz::sim::systems::PosePublisher">
      <publish_model_pose>true</publish_model_pose>
      <publish_link_pose>false</publish_link_pose>
      <publish_nested_model_pose>false</publish_nested_model_pose>
      <use_pose_vector_msg>false</use_pose_vector_msg>
      <update_frequency>500</update_frequency>
    </plugin>
  </gazebo>

</robot>
