<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>pady_robot</name>
  <version>1.0.0</version>
  <description>
    PaDy - Passive Dynamic Bipedal Walker
    MEng Final Year Project, University of Liverpool
    1.0m tall, 3.5kg, gravity-powered walking on 3-degree slopes.
  </description>
  <maintainer email="student@liverpool.ac.uk">Jadyn</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>urdf</depend>
  <depend>xacro</depend>
  <depend>ros_gz_sim</depend>
  <depend>robot_state_publisher</depend>
  <depend>joint_state_publisher</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
